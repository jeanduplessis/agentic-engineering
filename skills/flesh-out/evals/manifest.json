{
  "schema_version": 1,
  "skill": {
    "name": "flesh-out",
    "path": "../SKILL.md"
  },
  "suites": [
    {
      "name": "workflow",
      "type": "workflow",
      "mode": "forced",
      "fixture": {
        "type": "empty"
      },
      "cases": [
        {
          "id": "first-decision-question",
          "prompt": "I want to flesh out a plan for a small CLI that helps roommates track chores. Start the interview and ask the first decision question.",
          "checks": [
            {
              "id": "non-empty-response",
              "type": "non_empty_response"
            },
            {
              "id": "asks-numbered-question",
              "type": "regex",
              "pattern": "(?m)^## Question\\b"
            },
            {
              "id": "gives-recommendation",
              "type": "regex",
              "pattern": "(?is)## Recommendation\\s+.{1,500}"
            },
            {
              "id": "allows-accept-or-feedback",
              "type": "regex",
              "pattern": "(?is)(accept|feedback).{0,250}(custom|free[- ]form|feedback)"
            },
            {
              "id": "forbids-agreed-decisions-recap",
              "type": "forbidden_content",
              "value": "Agreed decisions:"
            },
            {
              "id": "forbids-options-heading",
              "type": "forbidden_content",
              "value": "Options:"
            },
            {
              "id": "forbids-rejected-alternatives",
              "type": "forbidden_content",
              "value": "Why not alternatives"
            }
          ]
        }
      ]
    }
  ],
  "configurations": {
    "with_skill": {
      "harness": "pi",
      "force_skill": true
    },
    "without_skill": {
      "harness": "pi",
      "force_skill": false
    }
  }
}

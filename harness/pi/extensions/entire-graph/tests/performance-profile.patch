--- /dev/null
+++ b/internal/sem/spike_timing.go
@@ -0,0 +1,16 @@
+package sem
+
+import (
+	"fmt"
+	"os"
+	"time"
+)
+
+// Temporary diagnostic instrumentation, not an optimization.
+func spikeStage(name string) func() {
+	if os.Getenv("GRAPH_SPIKE_TIMING") == "" {
+		return func() {}
+	}
+	start := time.Now()
+	return func() { fmt.Fprintf(os.Stderr, "GRAPH_SPIKE_STAGE %s %d\n", name, time.Since(start).Milliseconds()) }
+}
